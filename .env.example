# Filled in later, when the website is linked to the finished app.
# Both NEXT_PUBLIC_* and VITE_* prefixes are read (see vite.config.ts).
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_PLAY_URL=
NEXT_PUBLIC_APP_STORE_URL=
# Optional: mobile deep link / universal link base, e.g. https://your-domain/app
NEXT_PUBLIC_APP_DEEP_LINK=
# Optional: where "Apply to drive" should go once the app has driver sign-up. Empty = the form on /drive.
NEXT_PUBLIC_DRIVER_SIGNUP_URL=
# Forms. Leave empty to run in mock mode (console log + success state, nothing is sent).
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_DRIVERS_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_HELLO_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional social profile URLs. Empty = icon is hidden.
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
